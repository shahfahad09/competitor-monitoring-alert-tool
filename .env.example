# --- Hosting: makes the public read-only and keeps Settings/scan/AI private to you ---
ADMIN_PASSWORD=
# --- Optional: auto re-scan every N hours + weekly AI digest ---
SCHEDULE_HOURS=
# --- Optional: persistent DB path when hosting (e.g. /data/monitor.db) ---
DB_PATH=
# --- Optional: change AI models ---
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
# --- Email alerts need SMTP (Slack does not) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# API keys (Anthropic, DataForSEO, Keywords Everywhere) and Slack/email are normally entered in the Settings page.
